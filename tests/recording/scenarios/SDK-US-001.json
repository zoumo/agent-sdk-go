{
  "version": 4,
  "id": "SDK-US-001",
  "goal": "在长期会话中提交输入、追加输入并观察结果",
  "cases": [
    {
      "id": "SDK-CASE-001",
      "storyId": "SDK-US-001",
      "goal": "连续提交文本输入并在结果后继续观察",
      "required": true,
      "implementation": "implemented",
      "name": "simulation-001",
      "execution": {
        "mode": "live-selected-path",
        "reason": ""
      },
      "setup": {
        "files": {
          "numbers.txt": "7\n11\n"
        }
      },
      "inputs": {
        "input-1": "Reply with the word Ready.",
        "input-2": "Reply with the word Done."
      },
      "steps": [
        {
          "op": "session.open"
        },
        {
          "op": "input.submit",
          "input": "input-1"
        },
        {
          "op": "event.wait",
          "event": "execution.result",
          "onMissing": "untriggered"
        },
        {
          "op": "input.submit",
          "input": "input-2"
        },
        {
          "op": "event.wait",
          "event": "execution.result",
          "onMissing": "untriggered"
        },
        {
          "op": "session.close"
        }
      ],
      "expect": {
        "requests": [],
        "missingEvidence": "untriggered",
        "scope": "连续提交文本输入并在结果后继续观察。",
        "outOfScope": [
          "其他 case 的使用流程",
          "人工构造的协议错误和精确竞态"
        ]
      },
      "limits": {
        "inputs": 2,
        "activitySeconds": 0,
        "transportSeconds": 0,
        "protocolBytes": 0,
        "stderrBytes": 0
      },
      "driverProfile": "continuation",
      "parameters": {
        "requireSessionContinuation": true
      }
