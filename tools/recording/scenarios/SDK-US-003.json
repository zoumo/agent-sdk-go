{
  "version": 2,
  "id": "SDK-US-003",
  "goals": [
    "SDK-US-003"
  ],
  "name": "active-input",
  "execution": {
    "mode": "live-selected-path",
    "reason": ""
  },
  "setup": {
    "files": {
      "numbers.txt": "7\n11\n"
    }
  },
  "inputs": {
    "input-1": "Produce a numbered list from one to twenty.",
    "input-2": "Also include the word sample."
  },
  "steps": [
    {
      "op": "session.open"
    },
    {
      "op": "input.submit",
      "input": "input-1"
    },
    {
      "op": "event.wait",
      "event": "execution.progress",
      "onMissing": "untriggered"
    },
    {
      "op": "input.submit",
      "input": "input-2"
    },
    {
      "op": "event.wait",
      "event": "execution.result",
      "onMissing": "untriggered"
    },
    {
      "op": "session.close"
    }
  ],
  "expect": {
    "requests": [],
    "missingEvidence": "untriggered",
    "scope": "在一个原生进度屏障后追加一次输入，记录接受、拒绝或写入结果。",
    "caseId": "SDK-US-003/active-input",
    "outOfScope": [
      "其他调度结果",
      "追加输入的独立结果保证",
      "精确竞态"
    ]
  },
  "limits": {
    "inputs": 2,
    "activitySeconds": 110,
    "transportSeconds": 120,
    "protocolBytes": 2097152,
    "stderrBytes": 262144
  }
}
