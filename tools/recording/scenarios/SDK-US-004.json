{
  "version": 2,
  "id": "SDK-US-004",
  "goals": [
    "SDK-US-004"
  ],
  "name": "fixture-tools",
  "execution": {
    "mode": "live-selected-path",
    "reason": ""
  },
  "setup": {
    "files": {
      "numbers.txt": "7\n11\n"
    }
  },
  "inputs": {
    "input-1": "Read numbers.txt using the supplied read tool, then use the supplied write tool to write summary.txt with exactly total=18 followed by a newline. Use no other tools."
  },
  "steps": [
    {
      "op": "session.open"
    },
    {
      "op": "input.submit",
      "input": "input-1"
    },
    {
      "op": "event.wait",
      "event": "execution.result",
      "onMissing": "untriggered"
    },
    {
      "op": "session.close"
    }
  ],
  "expect": {
    "requests": [
      "fixture.read",
      "fixture.write"
    ],
    "missingEvidence": "untriggered",
    "scope": "对固定数字文件执行一次读取和一次精确写入，并观察任务结果。",
    "caseId": "SDK-US-004/fixture-tools",
    "outOfScope": [
      "后台任务结束",
      "其他工具和文件",
      "故障注入"
    ]
  },
  "limits": {
    "inputs": 1,
    "activitySeconds": 110,
    "transportSeconds": 120,
    "protocolBytes": 2097152,
    "stderrBytes": 262144
  }
}
