{
  "version": 2,
  "id": "SDK-US-010",
  "goals": [
    "SDK-US-010"
  ],
  "name": "deferred-approval",
  "execution": {
    "mode": "live-selected-path",
    "reason": ""
  },
  "setup": {
    "files": {
      "numbers.txt": "7\n11\n"
    }
  },
  "inputs": {
    "input-1": "Use Read exactly once to read numbers.txt. Then report the two integers briefly. Do not use other tools."
  },
  "steps": [
    {
      "op": "session.open"
    },
    {
      "op": "input.submit",
      "input": "input-1"
    },
    {
      "op": "event.wait",
      "event": "execution.result",
      "onMissing": "untriggered"
    },
    {
      "op": "session.close"
    }
  ],
  "expect": {
    "requests": [
      "permission.read",
      "permission.held-control",
      "permission.held-event"
    ],
    "missingEvidence": "untriggered",
    "scope": "持有一次读取审批，在回答前确认控制响应并消费其他原生事件。",
    "caseId": "SDK-US-010/deferred-approval",
    "outOfScope": [
      "超时和撤销",
      "重复回答",
      "其他审批类型"
    ]
  },
  "limits": {
    "inputs": 1,
    "activitySeconds": 110,
    "transportSeconds": 120,
    "protocolBytes": 2097152,
    "stderrBytes": 262144
  }
}
