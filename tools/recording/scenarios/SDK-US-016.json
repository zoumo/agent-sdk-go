{
  "version": 2,
  "id": "SDK-US-016",
  "goals": [
    "SDK-US-016"
  ],
  "name": "interrupt",
  "execution": {
    "mode": "live-selected-path",
    "reason": ""
  },
  "setup": {
    "files": {
      "numbers.txt": "7\n11\n"
    }
  },
  "inputs": {
    "input-1": "Produce a numbered list from one to twenty."
  },
  "steps": [
    {
      "op": "session.open"
    },
    {
      "op": "input.submit",
      "input": "input-1"
    },
    {
      "op": "event.wait",
      "event": "execution.progress",
      "onMissing": "untriggered"
    },
    {
      "op": "execution.interrupt"
    },
    {
      "op": "event.wait",
      "event": "execution.result",
      "onMissing": "untriggered"
    },
    {
      "op": "session.close"
    }
  ],
  "expect": {
    "requests": [],
    "missingEvidence": "untriggered",
    "scope": "在原生执行进度后中断一次，并观察中断响应和执行终态。",
    "caseId": "SDK-US-016/interrupt",
    "outOfScope": [
      "关闭 Session 分支",
      "任务回滚",
      "全部子任务停止"
    ]
  },
  "limits": {
    "inputs": 1,
    "activitySeconds": 110,
    "transportSeconds": 120,
    "protocolBytes": 2097152,
    "stderrBytes": 262144
  }
}
