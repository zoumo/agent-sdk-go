{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "provider": {
      "type": "string"
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "live-selected-path",
                  "offline-only",
                  "blocked"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "mode",
              "reason"
            ],
            "additionalProperties": false
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "requests": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "answers": {
            "type": "object"
          },
          "configuration": {
            "type": "object",
            "properties": {
              "timing": {
                "const": "before-first-input"
              },
              "modelSource": {
                "enum": [
                  "session",
                  "prepared-or-default"
                ]
              },
              "thinking": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "effort": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "effectiveValue": {
                "const": "unknown-unless-observed"
              }
            },
            "additionalProperties": false
          },
          "progressBarrier": {
            "type": [
              "string",
              "null"
            ]
          },
          "nativeStories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "offlineTest": {
            "type": "string"
          }
        },
        "required": [
          "files",
          "requests",
          "answers",
          "configuration",
          "progressBarrier",
          "nativeStories",
          "offlineTest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "provider",
    "scenarios"
  ],
  "additionalProperties": false
}
