{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "agent-recording-scenarios"
    },
    "version": {
      "const": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "version",
    "scenarios"
  ],
  "additionalProperties": false
}
